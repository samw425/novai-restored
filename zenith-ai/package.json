    "lucide-react": "^0.562.0",
    "mapbox-gl": "^3.18.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-leaflet": "^4.2.1",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@cloudflare/next-on-pages": "1.13.10",
    "@tailwindcss/postcss": "^4",
